# Copy this file to .env and adjust
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# ERP adapter: focus9-stub | erpnext
ERP_PROVIDER=focus9-stub

# --- ERPNext (used when ERP_PROVIDER=erpnext) ---
ERPNEXT_URL=https://your-site.erpnext.com
ERPNEXT_API_KEY=xxxxxxxx
ERPNEXT_API_SECRET=xxxxxxxx

# --- Focus9 (fill in once Focus Softnet provides API docs) ---
FOCUS9_URL=
FOCUS9_API_KEY=
