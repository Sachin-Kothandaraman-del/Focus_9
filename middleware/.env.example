# ── Copy to .env and fill in ─────────────────────────────────────────
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that become ACTIVE ADMINS automatically on signup.
# Sign up with this email first to bootstrap your admin account.
ADMIN_EMAILS=sachdukr@gmail.com

# ── Supabase (production database + auth) ────────────────────────────
# Leave empty to run in LOCAL DEMO MODE (JSON file DB + demo logins).
# Get these from supabase.com → your project → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── ERP adapter: focus9-stub | erpnext ───────────────────────────────
ERP_PROVIDER=focus9-stub

# ERPNext (when ERP_PROVIDER=erpnext)
ERPNEXT_URL=https://your-site.erpnext.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Focus9 (fill once Focus Softnet provides API docs)
FOCUS9_URL=
FOCUS9_API_KEY=
